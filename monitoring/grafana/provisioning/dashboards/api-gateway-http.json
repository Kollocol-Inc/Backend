          "expr": "100 * ((sum(increase(http_requests_total{job=\"api-gateway\",path=~\"$path\",method=~\"$method\",status=~\"5..\"}[$__range])) or vector(0)) / clamp_min(sum(increase(http_requests_total{job=\"api-gateway\",path=~\"$path\",method=~\"$method\"}[$__range])), 1))",
          "legendFormat": "5xx %",
          "refId": "A"
