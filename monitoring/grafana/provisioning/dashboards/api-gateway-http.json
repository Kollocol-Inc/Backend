          "expr": "100 * (sum(rate(http_requests_total{job=\"api-gateway\",path=~\"$path\",method=~\"$method\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=\"api-gateway\",path=~\"$path\",method=~\"$method\"}[$__rate_interval])), 0.0001))",
          "legendFormat": "5xx %",
          "refId": "A"
